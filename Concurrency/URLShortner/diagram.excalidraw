      "boundElements": [],
      "updated": 1791703544645,
      "link": null,
      "locked": false,
      "text": "1. Low latency (200ms)\n2. Support unique IDs\n3. Scale : 100M DAU, 1B users\n4. CAP: Availability > Consistency (eventual)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Low latency (200ms)\n2. Support unique IDs\n3. Scale : 100M DAU, 1B users\n4. CAP: Availability > Consistency (eventual)",
      "autoResize": true,
      "lineHeight": 1.25
    },
