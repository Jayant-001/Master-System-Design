      "text": "urls\n  short_code  VARCHAR(16)  PRIMARY KEY\n  long_url    TEXT         NOT NULL\n  user_id     BIGINT       NULL\n  is_custom   BOOLEAN\n  created_at  TIMESTAMP\n  expires_at  TIMESTAMP    NULL, indexed",
