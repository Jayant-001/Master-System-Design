      "boundElements": [],
      "updated": 1791710000000,
      "link": null,
      "locked": false,
      "text": "Back-of-envelope (assumptions):",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Back-of-envelope (assumptions):",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "est-b",
      "type": "text",
      "x": -350,
      "y": 374,
      "width": 340,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 1006,
      "version": 1,
      "versionNonce": 2006,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791710000000,
      "link": null,
      "locked": false,
      "text": "Reads: 100M DAU x ~1 click/day\n   ~1.2K/s avg, ~10K/s peak\nWrites: ~1M new URLs/day = ~12/s\n   -> read-heavy, ~100 : 1\nStorage: 1B URLs x 500 B = ~500 GB\nCode: base62, 62^6 = 56B > 1B\n   -> 7 chars for headroom",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reads: 100M DAU x ~1 click/day\n   ~1.2K/s avg, ~10K/s peak\nWrites: ~1M new URLs/day = ~12/s\n   -> read-heavy, ~100 : 1\nStorage: 1B URLs x 500 B = ~500 GB\nCode: base62, 62^6 = 56B > 1B\n   -> 7 chars for headroom",
      "autoResize": true,
      "lineHeight": 1.25
    },
