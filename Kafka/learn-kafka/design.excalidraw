      "customData": {
        "gen": "kafka-notes"
      },
      "text": "Your run printed order-5 before order-1 because they were in different partitions.\nInside P1, order-1 (offset 0) always comes before order-2 (offset 1).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Your run printed order-5 before order-1 because they were in different partitions.\nInside P1, order-1 (offset 0) always comes before order-2 (offset 1).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1D"
    },
